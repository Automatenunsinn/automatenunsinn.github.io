    "@types/jest": "^30.0.0",
    "@types/jquery": "^3.5.33",
    "@types/node": "^24.10.10",
    "@types/papaparse": "^5.5.2",
    "buffer": "^6.0.3",
    "esbuild": "^0.28.2",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "parse5": "^7.3.0",
    "sass": "1.77.6",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
